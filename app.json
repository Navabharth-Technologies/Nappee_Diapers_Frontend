{
  "expo": {
    "name": "Nappee Diapers",
    "slug": "Nappee_Diapers",
    "scheme": "nappeediapers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tejashwini_s.Nappee_Diapers",
      "config": {
        "googleMaps": {
          "apiKey": "dummy_key_to_prevent_crash_nappee_diapers"
        }
      }
    },
    "experiments": {
      "baseUrl": "/Nappee_Diapers"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
